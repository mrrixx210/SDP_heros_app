{
  "name": "@sdp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:migrations": "tsx scripts/test-migrations.ts",
    "lint": "eslint src --ext .ts",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "seed:agent-users": "tsx scripts/seed-agent-users.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@supabase/supabase-js": "^2.45.0",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8",
    "@sdp/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.5",
    "typescript": "^5.8.0",
    "vitest": "^2.0.5"
  }
}
