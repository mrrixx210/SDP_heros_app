# ============================================================================
# SDP Heroes v2 ... environment variables (matches build spec section 9).
# Copy to .env and fill in real values. NEVER commit .env.
# Production secrets live in ~/.sdp-heroes.env on the M4, loaded by pm2.
# ============================================================================

# ── Supabase (NEW project for SDP Heroes; Tony's project stays untouched) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ── Anthropic (Sonnet for customer-facing/financial; Haiku for batch) ──────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001

# ── OpenAI (Whisper fallback when WhisperKit on-device fails) ──────────────
OPENAI_API_KEY=sk-...

# ── Twilio (SMS) ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+12132247949

# ── Resend (transactional email) ───────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=trusso@superduperpros.com

# ── Stripe (payments + tap-to-pay terminal) ────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_TERMINAL_LOCATION_ID=tml_...

# ── QuickBooks Online (Vinny owns sync) ────────────────────────────────────
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=

# ── Meta Ads (daily spend + lead webhook) ─────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ── Google Ads (daily spend + conversions) ────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ── Banks (Vinny reconciliation) ──────────────────────────────────────────
MERCURY_API_KEY=
TRUSS_API_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ACCESS_TOKEN_CHASE=
PLAID_ACCESS_TOKEN_BOFA=

# ── Google Chat (build digest, ops alerts, approval queue) ────────────────
GOOGLE_CHAT_WEBHOOK_SDP_BUILD=
GOOGLE_CHAT_WEBHOOK_SDP_OPS=
GOOGLE_CHAT_WEBHOOK_APPROVAL_QUEUE=

# ── Sendblue (iMessage outbound) ─────────────────────────────────────────
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=

# ── Hermes (heartbeat + self-heal infra) ──────────────────────────────────
HERMES_HEARTBEAT_URL=

# ── Backup (Backblaze B2 nightly snapshot) ───────────────────────────────
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
B2_BUCKET=sdp-heroes-backup

# ── Cloudflare Tunnel (SEPARATE from Tony's tunnel) ──────────────────────
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_ID=

# ── Railway (warm failover deploy target) ────────────────────────────────
RAILWAY_PROJECT_ID=
RAILWAY_API_TOKEN=
RAILWAY_URL=

# ── API server (M4 local) ────────────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# ── Background workers (Redis via local Docker) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ── Admin panel (Next.js 14) ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ── Playwright QA (production smoke + failover) ─────────────────────────
SDP_ADMIN_URL=http://localhost:3001
SDP_API_URL=http://localhost:3000

# ── Agent API ────────────────────────────────────────────────────────────
# Tony's agent_users row gets seeded with a hashed bearer token. The raw
# token is generated by `pnpm --filter @sdp/api seed:agent-users` and
# delivered via secure channel ... never echoed to stdout.
AGENT_API_BEARER_HASH_SALT=
