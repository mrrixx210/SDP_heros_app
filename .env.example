# ===========================================================================
# SDP Heroes v2 ... environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# ===========================================================================

# ── Supabase (NEW project for SDP Heroes; Tony's project stays untouched) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ── API server ─────────────────────────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# ── Background workers (Redis via local Docker) ────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Admin panel (Next.js 14) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ── Stripe (payments) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── QuickBooks Online (accounting sync) ────────────────────────────────────
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/integrations/qbo/callback
QBO_REALM_ID=

# ── Sendblue (iMessage outbound) ──────────────────────────────────────────
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=

# ── Twilio (SMS) ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+12132247949

# ── Resend (email) ────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=trusso@superduperpros.com

# ── Plaid (bank ingest, Vinny pipeline) ───────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ── Mercury (banking) ─────────────────────────────────────────────────────
MERCURY_API_KEY=

# ── Truss (insurance billing) ─────────────────────────────────────────────
TRUSS_API_KEY=

# ── Anthropic (AI walkthroughs, summaries, anomaly detection) ─────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google (OAuth client for Calendar / Meet on the Heroes side) ─────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Meta (Marketing API for Insights ingest) ─────────────────────────────
META_ACCESS_TOKEN=

# ── Agent API ─────────────────────────────────────────────────────────────
# Tony's agent_users row gets seeded with a hashed bearer token. The raw
# token is generated by `pnpm --filter @sdp/api seed:agent-users` and
# delivered via Rick's secure channel ... never echoed to stdout.
AGENT_API_BEARER_HASH_SALT=

# ── Cloudflare Tunnel (separate from Tony's prod tunnel) ─────────────────
CLOUDFLARE_TUNNEL_ID_API=
CLOUDFLARE_TUNNEL_ID_ADMIN=
